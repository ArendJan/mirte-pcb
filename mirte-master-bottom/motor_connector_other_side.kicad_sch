	(text "I_{trip} = V_{ref}/(10*R_{sen})\n\n1.5 = 5/4\n\nRsense use:\nI_{rms}^{2} * R = 0.5^2 * 3 = 0.75W\n\n\n3v3:\n1.5 = 3.3/(10*0.2)\n\n0.5^2*0.2 = 0.05W\n\nUSE 3v3!!!\n"
		(exclude_from_sim no)
